    <string name="settings_title">OSS 设置</string>
    <string name="settings_intro">在阿里云 OSS 控制台创建 Bucket，并准备拥有该 Bucket 读写权限的 AccessKey（建议使用只授权该 Bucket 的 RAM 用户）。Endpoint、Region、Bucket、AccessKey 与 PC 端 .env 保持一致。</string>
    <string name="label_endpoint">Endpoint（地域节点）</string>
    <string name="hint_endpoint">例如 oss-cn-hangzhou.aliyuncs.com</string>
    <string name="label_region">Region（地域，可留空）</string>
    <string name="hint_region">例如 cn-hangzhou；留空时根据 Endpoint 自动推断</string>
    <string name="label_bucket">Bucket 名称</string>
    <string name="hint_bucket">例如 my-recordings</string>
    <string name="label_access_key">AccessKey ID</string>
    <string name="hint_access_key">RAM 用户的 AccessKey ID</string>
    <string name="label_secret_key">AccessKey Secret</string>
    <string name="hint_secret_key">保存在本机，使用 Android Keystore 加密</string>
    <string name="label_public_url">公开访问域名（可选）</string>
    <string name="hint_public_url">例如 https://my-bucket.oss-cn-hangzhou.aliyuncs.com，用于“打开”链接</string>
    <string name="label_prefix">对象前缀（可选）</string>
    <string name="hint_prefix">默认 recordings/</string>
    <string name="settings_security_note">安全提示：AccessKey ID 和 AccessKey Secret 会使用 Android Keystore 加密保存在本机，但应用本身仍能读取。请使用最小权限、仅限该 Bucket 的 AccessKey；手机丢失或泄露时请及时禁用或轮换。</string>
